# eda-marketing — example environment variables.
# Copy to .env and fill in only what you actually need.
# .env is not committed to git. No key is stored in code.
# Paid services are called only after an explicit yes from the user (see the gates in the docs).

# --- Research: last30days (MIT, github.com/mvanhorn/last30days-skill) ---
# Free without keys: Reddit, Hacker News, GitHub, Polymarket.
# Optional (may be paid, pay-as-you-go):
SCRAPECREATORS_KEY=        # YouTube/TikTok/Instagram (10K free calls, then paid)
X_BEARER_TOKEN=            # X API
XAI_API_KEY=               # alternative X backend
PERPLEXITY_KEY=            # paid
OPENROUTER_KEY=            # paid
BRAVE_SEARCH_KEY=          # 2K free queries per month
LAST30DAYS_BLUESKY_KEY=    # Bluesky app password (free)
LAST30DAYS_MEMORY_DIR=./research/trends/last30days

# --- Video ---
# Path to chrome-headless-shell for HyperFrames renders (defaults to the one Remotion provides).
PRODUCER_HEADLESS_SHELL_PATH=
# Alternative: a regular Chrome.
HYPERFRAMES_BROWSER_PATH=

# --- Transcription (local, free) ---
# Python with faster-whisper installed, and the model cache path.
MOS_ASR_PYTHON=
MOS_ASR_MODEL_DIR=
